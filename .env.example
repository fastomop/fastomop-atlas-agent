# NOTE: this file is the template. Copy it to `.env` and fill in real values.
# `.env` is git-ignored, so secrets stay local.

# ---------------------------------------------------------------------------
# Milvus (REQUIRED) — vector store for OMOP concept embeddings
# ---------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
COLLECTION_NAME=omop_clinical_concepts

# ---------------------------------------------------------------------------
# Embeddings (REQUIRED) — model used to embed clinical descriptions
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=abhinand/MedEmbed-large-v0.1

# ---------------------------------------------------------------------------
# LLM provider — pick ONE of the blocks below. config.toml decides which one
# each agent uses; the env vars below supply the credentials/connection.
# ---------------------------------------------------------------------------

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_KEY=your-api-key-here
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Optional: OHDSI WebAPI for OMOP vocabulary lookups
# ---------------------------------------------------------------------------
# WEBAPI_URL=http://localhost:8080/WebAPI
# WEBAPI_CDM_SOURCE=MIMIC

# ---------------------------------------------------------------------------
# Optional: where concept-set JSON files are written. Defaults to ./output
# ---------------------------------------------------------------------------
# OUTPUT_DIRECTORY=./output
